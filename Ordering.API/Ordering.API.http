@Ordering.API_HostAddress = http://localhost:5186

POST {{Ordering.API_HostAddress}}/api/ordering/checkout
Content-Type: application/json
Idempotency-Key: checkout-demo-001

{
  "userId": "user-123",
  "customerEmail": "student@example.com",
  "shippingAddress": "12 University Street, Cairo",
  "items": [
    { "productId": 1, "quantity": 1 },
    { "productId": 3, "quantity": 2 }
  ]
}

###

POST {{Ordering.API_HostAddress}}/api/ordering/checkout
Content-Type: application/json
Idempotency-Key: checkout-refund-demo-001

{
  "userId": "user-123",
  "customerEmail": "student@example.com",
  "shippingAddress": "12 University Street, Cairo",
  "simulateDatabaseFailure": true,
  "items": [
    { "productId": 1, "quantity": 1 }
  ]
}

###

GET {{Ordering.API_HostAddress}}/api/ordering/orders/users/user-123
Accept: application/json

